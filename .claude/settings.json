{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(python manage.py makemigrations:*)",
      "Bash(python manage.py test:*)",
      "Bash(python manage.py check:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout -- :*)",
      "Bash(pip install:*)",
      "Bash(python manage.py migrate:*)",
      "Bash(python manage.py flush:*)",
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(Remove-Item:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(**/credentials.json)",
      "Read(**/token.json)"
    ]
  }
}
