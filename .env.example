# Copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.

# Chave secreta do Django. Gere uma com:
#   venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# True só em desenvolvimento. No PC de casa (uso real): False.
DJANGO_DEBUG=False

# Endereço e porta do app. Hoje 127.0.0.1; no futuro, o IP do Tailscale.
KAIROS_HOST=127.0.0.1
KAIROS_PORT=8765

# Nome do banco dentro da pasta de dados.
# PC de casa: kairos.sqlite3 | Notebook (dev): dev.sqlite3
KAIROS_DB_NAME=kairos.sqlite3

# Opcional: outra pasta de dados. Padrão: %LOCALAPPDATA%\Kairos
# KAIROS_DATA_DIR=

# Agendas de empresa sincronizadas além da principal (etapa 4).
# Formato: Nome=email, Outro=email2   (o nome vira a etiqueta nas reuniões)
# GOOGLE_AGENDAS_EXTRAS=Empresa=voce@empresa.com
